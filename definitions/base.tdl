;; =========================================================
;; Tally Definition Language (TDL) - Full 2026 Menu & Reports
;; =========================================================

[Menu: Gateway of Tally]
Title : "Gateway of Tally"
;; MASTERS
Item : "Create" : Display : MasterCreateMenu
Item : "Alter" : Display : MasterAlterMenu
Item : "Chart of Accounts" : Display : AccountsInfo

;; TRANSACTIONS
Item : "Vouchers" : Display : VoucherEntry
Item : "Day Book" : Display : DayBook

;; UTILITIES
Item : "Banking & BRS" : Display : BankReconciliation
Item : "Payroll Pay Sheet" : Display : PayrollSummary

;; REPORTS
Item : "Balance Sheet" : Display : BalanceSheet
Item : "Profit & Loss A/c" : Display : ProfitAndLoss
Item : "Stock Summary" : Display : StockSummary
Item : "Ratio Analysis" : Display : RatioAnalysis
Item : "Bills Receivable (Ageing)" : Display : OutstandingReceivables
Item : "GSTR-1 Outward Return" : Display : GSTR1
Item : "GSTR-3B Monthly Summary" : Display : GSTR3B
Item : "Statutory Audit (Edit Log)" : Display : AuditEditLog
Item : "Trial Balance" : Display : TrialBalance
Item : "Fixed Assets & Depreciation" : Display : FixedAssets
Item : "Sales & Purchase Orders" : Display : OrderTracking
Item : "GSTR-2B ITC Reconciliation" : Display : GSTR2BRecon
Item : "Landed Cost Allocation" : Display : LandedCost
Item : "Point of Sale (POS)" : Display : POSBilling
Item : "Forex Revaluation Statement" : Display : ForexRevaluation
Item : "Delivery & Receipt Challans" : Display : Challans
Item : "TCS Register" : Display : TCSRegister
Item : "Job Work & Subcontracting" : Display : JobWorkRegister
Item : "Quality Inspection & QC" : Display : QualityInspection
Item : "Multi-Currency Rates" : Display : CurrencyExchange
Item : "Payment Reconciliation" : Display : PaymentRecon
Item : "Audit Trail Diff Viewer" : Display : AuditDiff
Item : "MSME 45-Day Compliance" : Display : MSMECompliance
Item : "Schedule III Balance Sheet" : Display : ScheduleIIIBalanceSheet
Item : "Rejections In & Out Register" : Display : RejectionsRegister
Item : "TDL Studio" : Display : TDLStudio
Item : "Quit" : Action : Quit

;; =========================================================
;; Report: Trial Balance
;; =========================================================
[Report: TrialBalance]
Title : "Trial Balance"
Form : TrialBalanceForm

[Form: TrialBalanceForm]
Part : TrialBalancePart

[Part: TrialBalancePart]
Line : TBHeaderLine, TBDetailLine
Repeat : TBDetailLine : AllLedgersCollection

[Line: TBHeaderLine]
Field : TBHeaderParticulars, TBHeaderGroup, TBHeaderDr, TBHeaderCr

[Field: TBHeaderParticulars]
Set as : "Particulars"
Width : 35

[Field: TBHeaderGroup]
Set as : "Parent Group"
Width : 25

[Field: TBHeaderDr]
Set as : "Debit (₹)"
Width : 18
Align : Right

[Field: TBHeaderCr]
Set as : "Credit (₹)"
Width : 18
Align : Right

[Line: TBDetailLine]
Field : TBLedgerName, TBGroupName, TBDebitAmount, TBCreditAmount

[Field: TBLedgerName]
Use : Name Field
Set as : $Name
Width : 35

[Field: TBGroupName]
Use : Name Field
Set as : $GroupName
Width : 25

[Field: TBDebitAmount]
Use : Amount Field
Set as : $DrAmount
Width : 18
Align : Right

[Field: TBCreditAmount]
Use : Amount Field
Set as : $CrAmount
Width : 18
Align : Right

[Collection: AllLedgersCollection]
Type : TrialBalance
Filter : NonZeroBalance

;; =========================================================
;; Report: Stock Summary (Inventory)
;; =========================================================
[Report: StockSummary]
Title : "Stock Summary"
Form : StockSummaryForm

[Form: StockSummaryForm]
Part : StockSummaryPart

[Part: StockSummaryPart]
Line : SSHeaderLine, SSDetailLine
Repeat : SSDetailLine : StockItemsCollection

[Line: SSHeaderLine]
Field : SSHItem, SSHUom, SSHQty, SSHRate, SSHValue

[Field: SSHItem]
Set as : "Item Description"
Width : 35

[Field: SSHUom]
Set as : "Unit"
Width : 10

[Field: SSHQty]
Set as : "Quantity"
Width : 15
Align : Right

[Field: SSHRate]
Set as : "Rate (₹)"
Width : 15
Align : Right

[Field: SSHValue]
Set as : "Closing Value (₹)"
Width : 20
Align : Right

[Line: SSDetailLine]
Field : SSItem, SSUom, SSQty, SSRate, SSValue

[Field: SSItem]
Use : Name Field
Set as : $Name
Width : 35

[Field: SSUom]
Set as : $Uom
Width : 10

[Field: SSQty]
Use : Amount Field
Set as : $ClosingQty
Width : 15
Align : Right

[Field: SSRate]
Use : Amount Field
Set as : $ClosingRate
Width : 15
Align : Right

[Field: SSValue]
Use : Amount Field
Set as : $ClosingValue
Width : 20
Align : Right

[Collection: StockItemsCollection]
Type : StockItem

;; ============================================================================
;; PHASE 3: NEW TDL DEFINITIONS & REPORTS
