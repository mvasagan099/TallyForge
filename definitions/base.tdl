[Report: FundsFlow]
Form : FundsFlowForm
Title : "Funds Flow Statement"

[Form: FundsFlowForm]
Part : FundsFlowPart

[Part: FundsFlowPart]
Line : FFHeaderLine

[Line: FFHeaderLine]
Field : FFParticularsField, FFAmountField

[Field: FFParticularsField]
Set as : "Particulars"
Width : 65

[Field: FFAmountField]
Set as : "Amount (₹)"
Width : 35
Align : Right

[Report: BudgetVariance]
Form : BudgetVarianceForm
Title : "Budget Variance Analysis"

[Form: BudgetVarianceForm]
Part : BudgetVariancePart

[Part: BudgetVariancePart]
Line : BVHeaderLine
Repeat : BVDetailLine : BudgetsCollection

[Line: BVHeaderLine]
Field : BVHBudget, BVHLedger, BVHBudgeted, BVHActual, BVHVariance

[Field: BVHBudget]
Set as : "Budget Name"
Width : 20

[Field: BVHLedger]
Set as : "Ledger"
Width : 28

[Field: BVHBudgeted]
Set as : "Budgeted (₹)"
Width : 18
Align : Right

[Field: BVHActual]
Set as : "Actual (₹)"
Width : 18
Align : Right

[Field: BVHVariance]
Set as : "Variance (₹)"
Width : 16
Align : Right

[Line: BVDetailLine]
Field : BVDName, BVDLedger, BVDBudgeted, BVDActual, BVDVariance

[Field: BVDName]
Set as : $BudgetName
Width : 20

[Field: BVDLedger]
Set as : $LedgerName
Width : 28

[Field: BVDBudgeted]
Use : Amount Field
Set as : $BudgetedAmount
Width : 18
Align : Right

[Field: BVDActual]
Use : Amount Field
Set as : $ActualAmount
Width : 18
Align : Right

[Field: BVDVariance]
Use : Amount Field
Set as : $Variance
Width : 16
Align : Right

[Collection: BudgetsCollection]
Type : Budget

[Report: InventoryAgeing]
Form : InventoryAgeingForm
Title : "Inventory Ageing Analysis"

[Form: InventoryAgeingForm]
Part : InventoryAgeingPart

[Part: InventoryAgeingPart]
Line : AgeingHeaderLine

[Line: AgeingHeaderLine]
Field : AgeItem, AgeQty, AgeVal, AgeB1, AgeB2, AgeB3, AgeB4

[Field: AgeItem]
Set as : "Stock Item"
Width : 28

[Field: AgeQty]
Set as : "Total Qty"
Width : 12
Align : Right

[Field: AgeVal]
Set as : "Value (₹)"
Width : 16
Align : Right

[Field: AgeB1]
Set as : "0-30 Days"
Width : 11
Align : Right

[Field: AgeB2]
Set as : "31-60 Days"
Width : 11
Align : Right

[Field: AgeB3]
Set as : "61-90 Days"
Width : 11
Align : Right

[Field: AgeB4]
Set as : ">90 Days"
Width : 11
Align : Right

